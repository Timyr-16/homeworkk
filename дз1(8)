a = float(input("Введіть перше число: "))
b = float(input("Введіть друге число: "))

action = input("Введіть дію (+, -, *, /): ")

if action == "+":
    print("Результат:", a + b)
elif action == "-":
    print("Результат:", a - b)
elif action == "*":
    print("Результат:", a * b)
elif action == "/":
    if b == 0:
        print("Ділення на нуль")
    else:
        print("Результат:", a / b)
else:
    print("Невідома дія")
